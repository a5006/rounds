{
  "expo": {
    "name": "ROUND PRO",
    "slug": "round-pro",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "roundpro",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.a5006.roundpro",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111318",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.a5006.roundpro",
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ROUND PRO Native Preview",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#111318",
          "imageWidth": 180
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/bells.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bdcf6b33-cc1f-4ea0-9918-53a50047cc47"
      }
    },
    "owner": "silanjavascript"
  }
}
